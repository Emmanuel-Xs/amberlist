# Postgres connection string (Neon). Leave empty locally to use the built-in PGlite database.
DATABASE_URL=
# Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, for example https://honeylist.vercel.app
BETTER_AUTH_URL=
# Optional: Google sign in. Both must be set or the "Continue with Google" button stays hidden.
# Create an OAuth client (Web application) in Google Cloud console > APIs & Services > Credentials.
# Redirect URI: <app url>/api/auth/callback/google (setup steps: context/features/guest-auth-and-google.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to call the auth API, comma separated (optional)
TRUSTED_ORIGINS=

# Optional: AI (Phase 3: "Break it down" and "Turn into tasks"). Set at least one key or every AI button stays hidden.
# Tried in this order, falling to the next on an error. 20 AI calls per user per day.
# Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini Flash backup: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# xAI Grok, a paid third option: https://console.x.ai
XAI_API_KEY=
# Optional model overrides when a default is retired (defaults: openai/gpt-oss-20b, gemini-flash-latest, grok-4.20-non-reasoning)
GROQ_MODEL=
GOOGLE_MODEL=
XAI_MODEL=
